  # --- Helper Function to Parse Timestamp (bez zmian) ---
  def parse_timestamp(timestamp_str):
      """Parses the lastPulledAt timestamp string into a timezone-aware datetime."""
      if not timestamp_str or timestamp_str == 'null' or timestamp_str == '0':
          return None
      try:
          timestamp_sec = int(timestamp_str) / 1000.0
          return timezone.make_aware(datetime.fromtimestamp(timestamp_sec), timezone.utc)
      except (ValueError, TypeError) as e:
          logger.warning(f"Could not parse timestamp '{timestamp_str}': {e}")
          raise ParseError(f"Invalid last_pulled_at timestamp format: {timestamp_str}")
  
  # --- Helper Function to Get Default Value (NOWA) ---
  def get_field_default(Model, field_name):
      """Pobiera wartość domyślną dla pola modelu Django."""
      try:
          field = Model._meta.get_field(field_name)
          # Sprawdź różne sposoby definiowania default
          if field.has_default():
              if callable(field.default):
                  # Jeśli default jest funkcją (np. timezone.now), nie możemy jej po prostu wywołać
                  # Zwracamy specjalny marker lub None, zakładając, że funkcje dynamiczne
                  # rzadko będą porównywane w logice migracji (zwykle to stałe wartości)
                  # Lub próbujemy obsłużyć znane przypadki jak uuid.uuid4
                  logger.warning(f"Callable default found for {Model.__name__}.{field_name}, cannot determine static default easily.")
                  return None # Lub inny marker
              return field.default
          # Dla pól NullBooleanField, default może nie być explicit, ale jest False
          if isinstance(field, django_models.BooleanField) and field.null:
               # Trudno jednoznacznie określić, czy None jest "domyślne" vs explicit null.
               # Traktujmy None jako potencjalny default dla nullable booleans
               return None
          if isinstance(field, django_models.BooleanField):
               return False # Domyślne dla non-nullable BooleanField
          # Dla innych typów bez explicit default, zazwyczaj nie ma domyślnej wartości innej niż None (jeśli nullable)
          return None # Brak explicit default
      except django_models.FieldDoesNotExist:
          logger.error(f"Field {field_name} not found in model {Model.__name__}")
          return None # Pole nie istnieje
  
  # --- Helper Function to Whitelist Migration Info (NOWA) ---
  def _get_whitelisted_migration_info(migration_info, user_id):
      """Filtruje migration_info, zostawiając tylko znane i dozwolone tabele/kolumny."""
      if not migration_info:
          return None
  
      whitelisted_info = {'from': migration_info.get('from'), 'tables': [], 'columns': []}
      allowed_tables = set(MODEL_SERIALIZER_MAP.keys())
  
      # Whitelist tables
      raw_tables = migration_info.get('tables', [])
      if isinstance(raw_tables, list):
          for table_name in raw_tables:
              if table_name in allowed_tables:
                  whitelisted_info['tables'].append(table_name)
              else:
                  logger.warning(f"Migration requested unknown table '{table_name}' for user {user_id}. Ignoring.")
  
      # Whitelist columns
      raw_columns_info = migration_info.get('columns', [])
      if isinstance(raw_columns_info, list):
          for col_entry in raw_columns_info:
              if not isinstance(col_entry, dict): continue
              table_name = col_entry.get('table')
              raw_columns = col_entry.get('columns')
  
              if not table_name or not isinstance(raw_columns, list) or table_name not in allowed_tables:
                   logger.warning(f"Migration requested invalid column entry or unknown table '{table_name}' for user {user_id}. Ignoring entry: {col_entry}")
                   continue
  
              # Pobierz dozwolone pola z serializera dla tej tabeli
              _, Serializer = MODEL_SERIALIZER_MAP[table_name]
              allowed_fields = set(Serializer.Meta.fields) - set(getattr(Serializer.Meta, 'read_only_fields', []))
              # Dodajmy też pola relacji *_id, które mogą być w 'fields'
              allowed_fields.update({f for f in Serializer.Meta.fields if f.endswith('_id')})
  
  
              whitelisted_columns = []
              for col_name in raw_columns:
                  # Sprawdź, czy kolumna (lub jej reprezentacja _id dla FK) jest w dozwolonych polach serializera
                  # lub jest to samo 'id'
                  if col_name in allowed_fields or f"{col_name}_id" in allowed_fields or col_name == 'id':
                      whitelisted_columns.append(col_name)
                  else:
                      logger.warning(f"Migration requested unknown/forbidden column '{col_name}' in table '{table_name}' for user {user_id}. Ignoring column.")
  
              if whitelisted_columns:
                  whitelisted_info['columns'].append({'table': table_name, 'columns': whitelisted_columns})
  
      # Zwróć tylko jeśli zawiera jakieś informacje o tabelach lub kolumnach
      if not whitelisted_info['tables'] and not whitelisted_info['columns']:
          return None
  
      return whitelisted_info
  
  # --- Helper Function to Apply Migration Changes (NOWA) ---
  def _apply_migration_changes(whitelisted_migration_info, user, changes, processed_created_ids, processed_updated_ids):
      """
      Pobiera dodatkowe dane wymagane przez migrację i dodaje je do obiektu 'changes'.
      Modyfikuje 'changes', 'processed_created_ids', 'processed_updated_ids' w miejscu.
      """
      if not whitelisted_migration_info:
          return
  
      logger.info(f"Applying migration sync logic for user {user.id}")
  
      # --- 1. Handle New Tables ---
      for table_name in whitelisted_migration_info.get('tables', []):
          if table_name not in MODEL_SERIALIZER_MAP: continue # Powinno być odfiltrowane, ale dla pewności
  
          Model, Serializer = MODEL_SERIALIZER_MAP[table_name]
          logger.debug(f"Migration: Fetching all records for new table '{table_name}' for user {user.id}")
  
          queryset = Model.objects.filter(user=user, is_deleted=False)
          new_table_records = Serializer(queryset, many=True).data
  
          if table_name not in changes: changes[table_name] = {"created": [], "updated": [], "deleted": []}
  
          for record in new_table_records:
              record_id = record['id']
              # Dodaj jako 'created', chyba że już istnieje w 'updated' z delta sync
              if record_id not in processed_updated_ids and record_id not in processed_created_ids:
                  changes[table_name]["created"].append(record)
                  processed_created_ids.add(record_id)
          logger.debug(f"Migration: Added {len(new_table_records)} records from new table '{table_name}'")
  
      # --- 2. Handle New Columns ---
      for col_info in whitelisted_migration_info.get('columns', []):
          table_name = col_info['table']
          new_columns = col_info['columns']
  
          if not new_columns or table_name not in MODEL_SERIALIZER_MAP: continue
  
          Model, Serializer = MODEL_SERIALIZER_MAP[table_name]
          logger.debug(f"Migration: Checking new columns {new_columns} in table '{table_name}' for user {user.id}")
  
          # Zbuduj filtr Q dla nie-domyślnych wartości
          q_filter = Q()
          has_valid_filter = False
          for col_name in new_columns:
              default_value = get_field_default(Model, col_name)
              # TODO: Lepsza obsługa różnych typów defaultów i wartości NULL
              if default_value is None:
                   # Jeśli default to None, szukamy wartości NIE NULL
                   q_filter |= ~Q(**{f"{col_name}__isnull": True})
                   has_valid_filter = True
              elif isinstance(default_value, bool):
                   # Dla Booleanów, szukamy wartości różnej od default
                   q_filter |= ~Q(**{col_name: default_value})
                   has_valid_filter = True
              elif isinstance(default_value, (int, float)) and default_value == 0:
                   # Dla numerycznych default=0, szukamy > 0 lub < 0 (lub != 0 jeśli to bardziej odpowiednie)
                   q_filter |= ~Q(**{col_name: 0})
                   has_valid_filter = True
              elif isinstance(default_value, str) and default_value == '':
                   # Dla stringów default='', szukamy niepustych
                   q_filter |= ~Q(**{col_name: ''})
                   has_valid_filter = True
              # Dodaj obsługę innych typowych defaultów, jeśli potrzebne
  
          if not has_valid_filter:
               logger.warning(f"Migration: Could not determine valid non-default filter for columns {new_columns} in {table_name}. Skipping column check.")
               continue
  
          # Pobierz rekordy pasujące do filtra
          queryset = Model.objects.filter(q_filter, user=user, is_deleted=False)
          updated_column_records = Serializer(queryset, many=True).data
  
          if not updated_column_records: continue # Nic do dodania
  
          if table_name not in changes: changes[table_name] = {"created": [], "updated": [], "deleted": []}
  
          added_count = 0
          for record in updated_column_records:
              record_id = record['id']
              # Dodaj jako 'updated', chyba że już jest w 'updated'
              if record_id not in processed_updated_ids:
                  # Jeśli był w 'created' z delta sync (mało prawdopodobne, ale możliwe), usuń go stamtąd
                  if record_id in processed_created_ids:
                      changes[table_name]["created"] = [r for r in changes[table_name]["created"] if r['id'] != record_id]
                      processed_created_ids.remove(record_id)
  
                  changes[table_name]["updated"].append(record)
                  processed_updated_ids.add(record_id)
                  added_count += 1
          logger.debug(f"Migration: Added {added_count} records with non-default new columns from table '{table_name}'")
  
  
