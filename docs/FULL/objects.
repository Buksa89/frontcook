      def get(self, request, *args, **kwargs):
          """Handles the Pull phase of WatermelonDB sync."""
          user = request.user
          logger.info(f"Sync PULL request started for user {user.id}")
  
          # 1. Parse Parameters
          last_pulled_at_str = request.query_params.get('last_pulled_at')
          schema_version = request.query_params.get('schema_version') # Może być użyte do bardziej złożonej logiki
          migration_json = request.query_params.get('migration')
  
          try:
              last_pulled_at = parse_timestamp(last_pulled_at_str)
              raw_migration_info = json.loads(migration_json) if migration_json and migration_json != 'null' else None
              # Whitelist migration info immediately for security
              whitelisted_migration_info = _get_whitelisted_migration_info(raw_migration_info, user.id)
          except json.JSONDecodeError:
              return Response({"error": "Invalid migration JSON format"}, status=status.HTTP_400_BAD_REQUEST)
          except ParseError as e:
              return Response({"error": str(e)}, status=status.HTTP_400_BAD_REQUEST)
  
          # 2. Get Current Server Timestamp
          current_server_time = timezone.now()
  
          # 3. Query Changes (Delta + Migration)
          changes = {}
          # Zbiory do śledzenia przetworzonych ID, aby uniknąć duplikatów
          processed_created_ids = set()
          processed_updated_ids = set()
          processed_deleted_ids = set() # Śledzimy też usunięte, choć migracje ich nie dodają
  
          try:
              # Używamy read committed lub lepszej izolacji, jeśli baza danych wspiera
              with transaction.atomic():
                  # --- A. Standard Delta Sync ---
                  if last_pulled_at:
                      for table_name, (Model, Serializer) in MODEL_SERIALIZER_MAP.items():
                          logger.debug(f"Delta Sync: Querying changes for table: {table_name}, LPT: {last_pulled_at}")
                          queryset = Model.all_objects.filter(user=user) # Używamy all_objects do znalezienia usuniętych
  
                          # Updated: Zmienione od LPT, nieusunięte
                          updated_qs = queryset.filter(last_modified__gt=last_pulled_at, is_deleted=False)
                          updated_records = Serializer(updated_qs, many=True).data
  
                          # Created: Utworzone (last_modified > LPT) ALE nie w updated_qs
                          # To jest uproszczenie; zakładamy, że last_modified jest dobrym wskaźnikiem nowości
                          created_qs = queryset.filter(last_modified__gt=last_pulled_at, is_deleted=False)\
                                                .exclude(pk__in=updated_qs.values_list('pk', flat=True))
                          created_records = Serializer(created_qs, many=True).data
  
                          # Deleted: Usunięte od LPT
                          deleted_qs = queryset.filter(is_deleted=True, deleted_at__gt=last_pulled_at)
                          deleted_record_ids = list(deleted_qs.values_list('id', flat=True))
  
                          if created_records or updated_records or deleted_record_ids:
                              changes[table_name] = {
                                  "created": created_records,
                                  "updated": updated_records,
                                  "deleted": deleted_record_ids,
                              }
                              # Zaktualizuj zbiory przetworzonych ID
                              for r in created_records: processed_created_ids.add(r['id'])
                              for r in updated_records: processed_updated_ids.add(r['id'])
                              processed_deleted_ids.update(deleted_record_ids)
                          logger.debug(f"Delta Sync for {table_name}: C={len(created_records)}, U={len(updated_records)}, D={len(deleted_record_ids)}")
                  else:
                      # --- Pierwsza Synchronizacja ---
                      for table_name, (Model, Serializer) in MODEL_SERIALIZER_MAP.items():
                           logger.debug(f"First Sync: Querying all records for table: {table_name}")
                           queryset = Model.objects.filter(user=user, is_deleted=False)
                           created_records = Serializer(queryset, many=True).data
                           if created_records:
                                changes[table_name] = {"created": created_records, "updated": [], "deleted": []}
                                for r in created_records: processed_created_ids.add(r['id'])
                           logger.debug(f"First Sync for {table_name}: Found {len(created_records)} records.")
  
                  # --- B. Apply Migration Sync Logic ---
                  # Ta funkcja zmodyfikuje 'changes' i zbiory 'processed_*_ids' w miejscu
                  _apply_migration_changes(
                      whitelisted_migration_info,
                      user,
                      changes,
                      processed_created_ids,
                      processed_updated_ids
                  )
  
          except Exception as e:
              logger.exception(f"Error during PULL query for user {user.id}: {e}")
              return Response({"error": "Failed to query changes"}, status=status.HTTP_500_INTERNAL_SERVER_ERROR)
  
          # 4. Format Timestamp
          response_timestamp = int(current_server_time.timestamp() * 1000)
  
          # 5. Return Response
          logger.info(f"Sync PULL request completed for user {user.id}. Sending {len(changes)} tables.")
          return Response({
              "changes": changes,
              "timestamp": response_timestamp,
          })
  
