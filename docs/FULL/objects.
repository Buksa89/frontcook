                          # Już zalogowano wyżej, można pominąć log tutaj lub dodać inny
                          continue
                      # ========================================
  
                      if table_name not in MODEL_SERIALIZER_MAP:
                          continue # Już zalogowano
  
                      Model, Serializer = MODEL_SERIALIZER_MAP[table_name]
  
                      # Created Records
                      created_list = change_set.get('created', [])
                      if not isinstance(created_list, list): continue # Log warning jak wcześniej
                      for raw_data in created_list:
                           # ... (logika przetwarzania created bez zmian) ...
                          if not isinstance(raw_data, dict) or 'id' not in raw_data: continue
                          record_id = raw_data['id']
                          logger.debug(f"Processing create for {table_name} ID {record_id}")
                          raw_data.pop('last_modified', None)
                          serializer = Serializer(data=raw_data)
                          try:
                              serializer.is_valid(raise_exception=True)
                              validated_data = serializer.validated_data
                              instance, created = Model.objects.update_or_create(
                                  id=record_id,
                                  user=user,
                                  defaults={**validated_data, 'user': user}
                              )
                              logger.info(f"{'Created' if created else 'Updated (via create)'} {table_name} ID {instance.id} (User {user.id})")
                          except (DRFValidationError, DjangoValidationError) as e:
                              raise DRFValidationError(f"Validation failed for created {table_name} ID {record_id}: {e}")
                  
                      # Updated Records
                      updated_list = change_set.get('updated', [])
                      if not isinstance(updated_list, list): continue # Log warning jak wcześniej
                      for raw_data in updated_list:
                          # ... (logika przetwarzania updated bez zmian) ...
                          if not isinstance(raw_data, dict) or 'id' not in raw_data: continue
                          record_id = raw_data['id']
                          logger.debug(f"Processing update for {table_name} ID {record_id}")
                          try:
                              instance = Model.objects.get(pk=record_id, user=user)
                          except ObjectDoesNotExist:
                              logger.warning(f"Update target not found for {table_name} ID {record_id} (User {user.id}). Attempting to create.")
                              raw_data.pop('last_modified', None)
                              serializer = Serializer(data=raw_data)
                              try:
                                  serializer.is_valid(raise_exception=True)
                                  validated_data = serializer.validated_data
                                  instance = Model.objects.create(id=record_id, user=user, **validated_data)
                                  logger.info(f"Created (via update) {table_name} ID {instance.id} (User {user.id})")
                                  continue
                              except (DRFValidationError, DjangoValidationError) as e:
                                  raise DRFValidationError(f"Validation failed for updated (create attempt) {table_name} ID {record_id}: {e}")
  
                          if instance.last_modified > last_pulled_at:
                              raise ConflictError(f"Conflict updating {table_name} id={instance.id}")
  
                          raw_data.pop('last_modified', None)
                          serializer = Serializer(instance, data=raw_data, partial=True)
                          try:
                              serializer.is_valid(raise_exception=True)
                              serializer.save()
                              logger.info(f"Updated {table_name} ID {instance.id} (User {user.id})")
                          except (DRFValidationError, DjangoValidationError) as e:
                               raise DRFValidationError(f"Validation failed for updated {table_name} ID {record_id}: {e}")
  
          except ConflictError as e:
              logger.warning(f"Push conflict detected for user {user.id}: {e}")
              return Response({"error": "Conflict detected. Pull changes again.", "details": str(e)}, status=status.HTTP_409_CONFLICT)
          except (DRFValidationError, ParseError) as e:
               logger.warning(f"Push validation/parse error for user {user.id}: {e}")
               details = e.detail if hasattr(e, 'detail') else str(e)
               return Response({"error": "Invalid push data.", "details": details}, status=status.HTTP_400_BAD_REQUEST)
          except Exception as e:
              logger.exception(f"Unexpected error during PUSH for user {user.id}: {e}")
              return Response({"error": "Server error during push processing."}, status=status.HTTP_500_INTERNAL_SERVER_ERROR)
  
          # 3. Return Success
          logger.info(f"Sync PUSH request completed successfully for user {user.id}.")
          return Response(status=status.HTTP_204_NO_CONTENT)


dokumentacja projektu:
**Dokumentacja Biznesowa Projektu SmartCook (Backend)**

**I. Wprowadzenie i Cel Projektu**

Celem projektu SmartCook jest stworzenie backendu dla aplikacji mobilnej do zarządzania przepisami kulinarnymi. Kluczową funkcjonalnością jest **automatyczna synchronizacja danych** między aplikacją mobilną (React Native) a serwerem Django przy użyciu biblioteki **WatermelonDB**. Umożliwia to użytkownikom pracę z przepisami zarówno online, jak i offline. Backend udostępnia również API do operacji niewymagających synchronizacji (np. autentykacja, import) oraz obsługuje zadania w tle (np. przetwarzanie importowanych danych).

**II. Architektura Ogólna**

*   **Backend:** Django (Python)
*   **API:** Django REST Framework (DRF) + drf-spectacular (OpenAPI Schema)
*   **Synchronizacja:** WatermelonDB (po stronie klienta), dedykowany endpoint `/api/sync/` w Django.
*   **Baza Danych:** PostgreSQL (konfiguracja przez `DATABASE_URL`)
*   **Zadania Asynchroniczne:** Celery z RabbitMQ jako brokerem wiadomości.
*   **Autentykacja API:** JWT (djangorestframework-simplejwt) z obsługą tokenów odświeżających.
*   **Przechowywanie Plików (Media):** Amazon S3 (lub kompatybilny, np. Wasabi) przez `django-storages`.
*   **Przetwarzanie LLM:** LiteLLM jako interfejs do różnych modeli językowych.
*   **Deployment:** Docker (`docker-compose.yaml`).

**III. Modele Danych i Logika Biznesowa**

Opis kluczowych modeli danych, ich pól oraz uzasadnienia biznesowego. Modele oznaczone jako `[SYNC]` dziedziczą po `BaseSyncModel` i podlegają synchronizacji z WatermelonDB.

1.  **Przepisy (`recipes` app)**
    *   **`Recipe` [SYNC]:** Główny model reprezentujący przepis kulinarny.
        *   **Pola Kluczowe (Biznesowo):**
            *   `name`, `description`, `instructions`, `notes`, `nutrition`: Podstawowe treści przepisu wprowadzane/edytowane przez użytkownika lub importowane.
            *   `rating` (0-5): Ocena przepisu przez użytkownika.
            *   `prep_time`, `total_time`: Czasy przygotowania i całkowity (w minutach).
            *   `servings`: Liczba porcji, na którą рассчитан przepis.
            *   `video`: Link do filmu (np. YouTube) powiązanego z przepisem.
            *   `source`: URL źródłowy, skąd przepis został oryginalnie pobrany (jeśli dotyczy).
            *   `image` (ImageField, nullable): **(Zgodnie z planowaną zmianą)** Pojedynczy, opcjonalny obrazek dla przepisu, przechowywany w S3. **Uwaga:** Sam plik obrazu *nie* jest synchronizowany przez WatermelonDB. Zarządzanie plikiem (upload/delete) odbywa się przez dedykowany endpoint API (`/api/recipes/{recipe_id}/image/`). Synchronizowany jest jedynie URL do obrazka (pole `image_url` w serializatorze `RecipeSyncSerializer`).
            *   `is_approved` (Boolean): **Cel:** Pozwala użytkownikowi oznaczyć przepis (zwłaszcza zaimportowany lub wygenerowany przez LLM) jako sprawdzony i "gotowy do użycia". Aplikacja mobilna domyślnie może filtrować przepisy, pokazując tylko te zatwierdzone na głównej liście, a niezatwierdzone w osobnym miejscu do weryfikacji.
        *   **Pola Systemowe:** `id` (UUID), `user`, `created_at`, `last_modified`, `is_deleted`, `deleted_at` (z `BaseSyncModel`), `source_obj` (ForeignKey do `Source`, server-only).
        *   **Logika Usuwania (Soft Delete):** Usunięcie przepisu przez mechanizm synchronizacji (lub bezpośrednio przez `recipe.delete()`) ustawia flagę `is_deleted=True` oraz `deleted_at` i aktualizuje `last_modified`. **Kluczowe:** Ta operacja wyzwala również kaskadowy *soft delete* na wszystkich powiązanych, synchronizowanych obiektach (`Ingredient`, `RecipeTag`), zapewniając, że ich usunięcie zostanie również zsynchronizowane z klientem.

    *   **`Source` (NIE SYNC):** Model przechowujący oryginalne źródło przepisu (URL, tekst, plik PDF/obraz/import z innej aplikacji).
        *   **Cel:** Archiwizacja danych wejściowych na serwerze. Umożliwia ewentualne ponowne przetworzenie źródła w przyszłości (np. przy użyciu lepszego modelu LLM) bez konieczności ponownego przesyłania przez użytkownika. Nie jest potrzebny w aplikacji mobilnej.
        *   **Pola:** `id`, `user`, `type`, `url`, `text`, `file_path`, `created_at`, `updated_at`.

2.  **Składniki i Lista Zakupów (`recipes`, `shopping_list` apps)**
    *   **`Ingredient` [SYNC]:** Składnik w kontekście konkretnego przepisu.
        *   **Cel:** Reprezentuje pozycję na liście składników danego przepisu, wraz z ilością, jednostką i nazwą.
        *   **Pola:** `id`, `user`, `recipe` (FK), `amount`, `unit`, `name`, `type` (np. "Nabiał"), `order` (kolejność w przepisie), `original_str` (oryginalny wpis), `last_modified`, `is_deleted`, `deleted_at`.
        *   **Parsowanie:** Odbywa się w metodzie `save()` modelu – przy tworzeniu nowego składnika z `original_str`, pola `name`, `amount`, `unit` są automatycznie wypełniane.
    *   **`ShoppingItem` [SYNC]:** Pozycja na liście zakupów użytkownika.
        *   **Cel:** Niezależna pozycja na liście zakupów. Może pochodzić ze składnika przepisu, ale może też być dodana ręcznie. Użytkownik zarządza jej stanem (`is_checked`) i kolejnością (`order`).
        *   **Pola:** `id`, `user`, `amount`, `unit`, `name`, `type` (np. "Warzywa"), `order` (kolejność na liście), `is_checked`, `last_modified`, `is_deleted`, `deleted_at`.
        *   **Relacja z `Ingredient`:** Brak bezpośredniej relacji w bazie. Logika dodawania składników do listy zakupów (tworzenie `ShoppingItem` na podstawie `Ingredient`) leży po stronie klienta lub dedykowanego endpointu API (jeśli będzie potrzebny).

3.  **Tagi (`recipes` app)**
    *   **`Tag` [SYNC]:** Reprezentuje tag (kategorię), który może być przypisany do wielu przepisów.
        *   **Cel:** Umożliwia kategoryzację i filtrowanie przepisów. Unikalność `(user, name)` zapobiega duplikatom tagów dla danego użytkownika.
        *   **Pola:** `id`, `user`, `name`, `order` (umożliwia użytkownikowi sortowanie tagów w interfejsie), `last_modified`, `is_deleted`, `deleted_at`.
    *   **`RecipeTag` [SYNC]:** Model pośredniczący (through model) dla relacji ManyToMany między `Recipe` a `Tag`.
        *   **Cel:** Łączy przepis z tagiem. Dziedziczy po `BaseSyncModel`, aby synchronizować same powiązania.
        *   **Pola:** `id`, `user`, `recipe` (FK), `tag` (FK), `last_modified`, `is_deleted`, `deleted_at`.

4.  **Ustawienia Użytkownika (`users` app)**
    *   **`ClientUserSettings` [SYNC]:** Ustawienia specyficzne dla klienta, synchronizowane, potencjalnie istniejące offline.
        *   **Cel:** Przechowywanie preferencji klienta (obecnie tylko język), które muszą być dostępne od razu po uruchomieniu aplikacji, nawet przed pełną synchronizacją.
        *   **Pola:** `id`, `user` (OneToOne), `language`, `last_modified`, `is_deleted`, `deleted_at`.
    *   **`UserProfile` [SYNC]:** Dane profilu użytkownika zarządzane głównie przez serwer, synchronizowane tylko *z serwera do klienta*.
        *   **Cel:** Przechowywanie informacji o koncie użytkownika, które nie powinny być modyfikowane przez klienta przez mechanizm sync (np. status subskrypcji).
        *   **Pola:** `id`, `user` (OneToOne), `subscription_end`, `csv_lock`, `last_modified`, `is_deleted`, `deleted_at`.
        *   **Synchronizacja:** Klient POBIERA (PULL) zmiany w tym modelu, ale NIE WYSYŁA (PUSH) zmian. Modyfikacje tych danych następują po stronie serwera (np. przez API płatności, panel admina).
    *   **`ServerUserSettings` (NIE SYNC):** Globalne ustawienia serwera, zarządzane przez admina.
        *   **Cel:** Konfiguracja parametrów działania backendu (np. domyślne zachowanie tłumaczeń). Niepotrzebne offline.
        *   **Pola:** `id`, `auto_translate_recipes`, `created_at`, `updated_at`.

5.  **Powiadomienia (`notifications` app)**
    *   **`Notification` [SYNC]:** Powiadomienie dla użytkownika.
        *   **Cel:** Informowanie użytkownika o zdarzeniach (np. zakończony import, zaproszenie do znajomych). Synchronizowane, aby użytkownik widział je na wszystkich swoich urządzeniach.
        *   **Pola:** `id`, `user`, `content` (treść HTML), `type` (success, info, fail), `link` (potencjalny deep link), `is_read`, `order`, `last_modified`, `is_deleted`, `deleted_at`.

6.  **Znajomi (`friends` app)**
    *   **`Friendship` (NIE SYNC):** Reprezentuje relację (zaproszenie, znajomość) między dwoma użytkownikami.
        *   **Cel:** Obsługa funkcjonalności społecznościowych (przeglądanie przepisów znajomych, udostępnianie - **TODO**). Ponieważ wymaga to interakcji w czasie rzeczywistym i sprawdzania uprawnień, jest to funkcja online, nie synchronizowana przez WatermelonDB.
        *   **Pola:** `id`, `sender`, `receiver`, `status` ('pending', 'accepted', 'rejected'), `created_at`, `updated_at`.
        *   **Status `rejected`:** **Logika:** Odrzucenie zaproszenia *blokuje* możliwość ponownego wysłania zaproszenia między tymi dwoma użytkownikami w *dowolnym* kierunku. Aby ponownie nawiązać kontakt, odrzucenie musi zostać usunięte (np. przez admina lub niezaimplementowaną funkcję "odblokuj").

7.  **Logowanie Użycia LLM (`llm` app)**
    *   **`LLMUsageLog`, `LLMModel`, `UserModelAvailability` (NIE SYNC):** Modele służące do śledzenia użycia i kosztów API LLM oraz konfiguracji dostępnych modeli dla użytkowników.
        *   **Cel:** Monitorowanie, analiza kosztów, potencjalne limitowanie dostępu w przyszłości. Dane potrzebne tylko na serwerze.

**IV. Synchronizacja Danych (WatermelonDB)**

*   **Strategia:** Używamy mechanizmu synchronizacji opartego na sygnaturach czasowych (`last_pulled_at`) i flagach soft-delete (`is_deleted`, `deleted_at`), zgodnie z wymaganiami WatermelonDB. Kiedy obiekt nadrzędny (np. `Recipe`) jest usuwany (soft delete), powiązane z nim obiekty synchronizowane (np. `Ingredient`, `RecipeTag`) również są oznaczane jako usunięte (soft delete) z odpowiednimi sygnaturami czasowymi, co zapewnia spójność po stronie klienta.
*   **Modele Synchronizowane:** `Recipe`, `Ingredient`, `Tag`, `RecipeTag`, `ShoppingItem`, `Notification`, `ClientUserSettings`, `UserProfile`. Synchronizowane są tylko obiekty należące do zalogowanego użytkownika (`user`=request.user). `UserProfile` jest synchronizowany tylko w kierunku serwer -> klient. Pole `Recipe.image` (plik) *nie* jest synchronizowane; synchronizowany jest tylko `image_url`.
*   **Model Bazowy (`BaseSyncModel`):** Dostarcza wspólnych pól (`id` UUID, `user`, `created_at`, `last_modified`, `is_deleted`, `deleted_at`) i logiki (aktualizacja `last_modified` przy `save`, obsługa `soft delete` przy `delete` wraz z wywołaniem `_handle_cascading_soft_delete`).
*   **Pierwsza Synchronizacja / Łączenie Danych Offline:**
    *   **Założenie:** Użytkownik może używać aplikacji offline i tworzyć dane (przepisy, tagi, lista zakupów, ustawienia klienta) *przed* pierwszym zalogowaniem/rejestracją.
    *   **Strategia:** Przy pierwszej synchronizacji PUSH po zalogowaniu/rejestracji, klient wysyła *wszystkie* swoje lokalne dane (oznaczone jako "created") wraz z ich lokalnie wygenerowanymi **UUID**.
    *   **Logika Serwera (w `SyncView.post` - **TODO: Wymaga implementacji warunkowej**):** Serwer musi wykryć, że jest to pierwszy push (np. brak poprzedniego `last_pulled_at` lub specjalna flaga). W takim przypadku dla rekordów "created" z klienta:
        1.  *Ufa* dostarczonemu przez klienta UUID i używa go jako klucza głównego.
        2.  Tworzy nowy rekord na serwerze z danymi od klienta i tym UUID.
        3.  *Nie* generuje nowego UUID po stronie serwera dla tych rekordów.
    *   **Konsekwencje:** Pozwala to zachować dane stworzone offline. Istnieje minimalne ryzyko kolizji UUID i potencjalne nadpisanie danych, jeśli użytkownik pracował równolegle online na innym urządzeniu przed pierwszym pushem tego klienta.
*   **Obsługa Konfliktów PUSH:** Jeśli klient próbuje zaktualizować (`updated`) lub usunąć (`deleted`) rekord, który został zmodyfikowany na serwerze *po* czasie `last_pulled_at` klienta, serwer zwraca błąd **409 Conflict**. Klient musi wtedy najpierw wykonać PULL, rozwiązać konflikty lokalnie i spróbować PUSH ponownie.
*   **Zarządzanie Plikami (np. Obrazki Przepisów):** Pliki binarne nie są synchronizowane przez WatermelonDB. Zmiany w plikach (np. dodanie/usunięcie obrazka przepisu) są obsługiwane przez dedykowane endpointy API. Aby klient dowiedział się o zmianie, operacja na pliku musi zaktualizować pole `last_modified` powiązanego rekordu synchronizowanego (np. `Recipe`). W odpowiedzi PULL klient otrzyma zaktualizowany rekord (np. `Recipe` z nowym `image_url` lub `null`) i na tej podstawie odświeży odpowiednie dane (np. pobierze nowy obrazek z URL).


**V. Interfejs API (`/api/`)**

Backend udostępnia RESTful API do obsługi operacji, które nie są częścią standardowej synchronizacji WatermelonDB lub wymagają dodatkowej logiki po stronie serwera.

1.  **Autentykacja i Konta (`/api/auth/`)**
    *   **Cel:** Zarządzanie cyklem życia użytkownika i jego sesji API.
    *   **Endpointy:**
        *   `POST /register/`: Rejestracja nowego użytkownika. Tworzy użytkownika, ale konto wymaga aktywacji. Wysyła email weryfikacyjny z unikalnym linkiem.
        *   `POST /login/`: Logowanie użytkownika za pomocą nazwy użytkownika lub adresu email i hasła. Zwraca parę tokenów JWT (access i refresh). Sprawdza, czy email użytkownika został zweryfikowany – jeśli nie, logowanie jest blokowane.
        *   `POST /refresh-token/`: Odświeżenie wygasłego tokenu dostępowego (`access`) przy użyciu ważnego tokenu odświeżającego (`refresh`). Zwraca nowy token dostępowy. Opcjonalnie rotuje token odświeżający.
        *   `POST /logout/`: Wylogowanie użytkownika poprzez dodanie dostarczonego tokenu odświeżającego (`refresh_token`) do czarnej listy (blacklist). Uniemożliwia to dalsze używanie tego tokenu do odświeżania sesji. Wymaga bycia zalogowanym (ważny `access token`).
        *   `POST /verify-email/`: Weryfikacja adresu email przy użyciu tokenu UUID przekazanego w ciele żądania. Endpoint przeznaczony głównie dla testów lub specyficznych klientów API.
        *   `GET /verify-email/<uuid:token>/`: Weryfikacja adresu email przez kliknięcie linku z wiadomości email. Token jest częścią ścieżki URL. Renderuje stronę HTML z potwierdzeniem lub błędem.
        *   `POST /forgot-password/`: Rozpoczęcie procesu resetowania zapomnianego hasła. Przyjmuje adres email, znajduje użytkownika i wysyła email z unikalnym linkiem do resetu hasła.
        *   `GET /reset-password/<uuid:token>/`: Wyświetlenie formularza do ustawienia nowego hasła. Dostępny po kliknięciu linku z emaila. Renderuje stronę HTML.
        *   `POST /reset-password/<uuid:token>/`: Przetworzenie formularza zmiany hasła. Przyjmuje nowe hasło (i jego potwierdzenie), weryfikuje token, ustawia nowe hasło dla użytkownika i unieważnia token resetujący. Renderuje stronę HTML z potwierdzeniem lub błędem.
        *   `POST /change-password/`: Zmiana hasła przez zalogowanego użytkownika. Wymaga podania starego hasła oraz nowego hasła (z potwierdzeniem).

2.  **Synchronizacja (`/api/sync/`)**
    *   **Cel:** Główny, centralny endpoint dla mechanizmu synchronizacji WatermelonDB. Obsługuje zarówno pobieranie zmian z serwera (Pull), jak i wysyłanie zmian z klienta (Push).
    *   **Endpointy:**
        *   `GET /`: **Faza PULL.** Klient wysyła opcjonalny parametr `last_pulled_at` (timestamp ostatniej synchronizacji w milisekundach). Serwer zwraca obiekt JSON zawierający:
            *   `changes`: Słownik, gdzie kluczami są nazwy tabel (np. `recipes`, `ingredients`), a wartościami są obiekty z trzema listami: `created` (nowe rekordy), `updated` (zmienione rekordy od `last_pulled_at`) i `deleted` (lista ID rekordów usuniętych przez soft delete od `last_pulled_at`). Zawiera tylko rekordy należące do zalogowanego użytkownika. **Nie zawiera** pola `Recipe.image` (pliku), tylko `Recipe.image_url`.
            *   `timestamp`: Aktualny timestamp serwera (w milisekundach), który klient powinien zapisać jako nowy `last_pulled_at`.
            *   *Obsługa Migracji (Opcjonalna):* Jeśli klient prześle parametr `migration`, serwer może dodatkowo dołączyć do `changes` całe tabele lub rekordy z nowymi kolumnami, zgodnie z logiką migracji.
        *   `POST /`: **Faza PUSH.** Klient wysyła w ciele żądania obiekt JSON z kluczem `changes`, zawierający zmiany dokonane lokalnie od ostatniego `last_pulled_at` (przekazanego jako parametr query). Serwer próbuje zastosować te zmiany:
            *   Przetwarza `deleted` (wykonuje soft delete).
            *   Przetwarza `created` (tworzy nowe rekordy, używając UUID klienta przy pierwszym pushu).
            *   Przetwarza `updated` (aktualizuje istniejące rekordy).
            *   **Ignoruje** wszelkie próby modyfikacji tabeli `user_profile`.
            *   Wykrywa konflikty (jeśli `last_modified` rekordu na serwerze jest nowsze niż `last_pulled_at` klienta) i zwraca błąd `409 Conflict`.
            *   W przypadku sukcesu zwraca status `204 No Content`. W przypadku błędu walidacji zwraca `400 Bad Request`.

3.  **Przepisy i Powiązane (`/api/recipes/`)**
    *   **Cel:** Operacje związane z przepisami, które nie są częścią standardowej synchronizacji (głównie import i zarządzanie obrazkami).
    *   **Endpointy Importu (Asynchroniczne):**
        *   `POST /from-url/`: Rozpoczyna proces importu przepisu z podanego URL. Zapisuje URL w modelu `Source`. Uruchamia zadanie Celery. Zwraca `202 Accepted` z ID zadania.
        *   `POST /from-screenshot/`: Rozpoczyna proces importu przepisu z przesłanego pliku obrazu (screenshot). Zapisuje plik w `Source`. Uruchamia zadanie Celery. Zwraca `202 Accepted` z ID zadania.
        *   `POST /from-pdf/`: Rozpoczyna proces importu przepisu z przesłanego pliku PDF. Zapisuje plik w `Source`. Uruchamia zadanie Celery. Zwraca `202 Accepted` z ID zadania.
        *   `POST /from-text/`: Rozpoczyna proces importu przepisu z przesłanego tekstu. Zapisuje tekst w `Source`. Uruchamia zadanie Celery. Zwraca `202 Accepted` z ID zadania.
    *   **Endpoint Zarządzania Obrazkiem Przepisu:**
        *   `POST /<uuid:recipe_id>/image/`: Uploaduje (lub zastępuje istniejący) plik obrazu dla przepisu o podanym `recipe_id`. Wymaga uprawnień do przepisu. Aktualizuje pole `Recipe.image` oraz `Recipe.last_modified`. Zwraca `200 OK` z nowym `image_url`.
        *   `DELETE /<uuid:recipe_id>/image/`: Usuwa plik obrazu powiązany z przepisem o podanym `recipe_id`. Czyści pole `Recipe.image` i aktualizuje `Recipe.last_modified`. Zwraca `204 No Content`.
    *   **Informacja Zwrotna z Importu:** Po zakończeniu zadania Celery (importu), użytkownik otrzymuje `Notification` (synchronizowaną przez `/api/sync/`) informującą o sukcesie lub porażce importu.
    *   **Pobieranie Obrazków:** Aplikacja mobilna pobiera `image_url` dla przepisu przez standardowy mechanizm PULL (`GET /api/sync/`). Następnie używa tego URL do bezpośredniego pobrania obrazka z S3 (lub innego skonfigurowanego storage backendu). Backend API nie służy jako pośrednik w pobieraniu plików obrazków.

4.  **Import z Innych Aplikacji (`/api/ninja/`)**
    *   **Cel:** Umożliwienie importu danych z kompatybilnych aplikacji firm trzecich.
    *   **Endpointy:**
        *   `GET /apps/`: Zwraca słownik dostępnych aplikacji (`{ app_id: { name: ..., hint: ..., available_files: [...] } }`), z których można importować dane (np. `myrecipebox`).
        *   `POST /import/`: Przyjmuje `app` (ID aplikacji) i `file` (plik eksportu, np. `.csv`, `.rtk`). Zapisuje plik w `Source`. Uruchamia zadanie Celery (`process_ninja_import`), które wywołuje odpowiedni importer dla danej aplikacji. Zwraca `202 Accepted` z ID zadania.

5.  **Profil i Ustawienia (`/api/users/`)**
    *   **Cel:** Dostęp do danych profilu użytkownika i globalnych ustawień serwera.
    *   **Endpointy:**
        *   `GET /profile/`: Zwraca `UserProfile` zalogowanego użytkownika (zawiera m.in. `subscription_end`, `csv_lock`). Tworzy profil z domyślnymi (zerowymi) wartościami, jeśli nie istnieje.
        *   `GET /server-user-settings/`: (Tylko Admin) Zwraca globalne ustawienia serwera (`ServerUserSettings`).
        *   `PUT /server-user-settings/`: (Tylko Admin) Aktualizuje globalne ustawienia serwera.

6.  **Znajomi (`/api/friends/`) - TODO**
    *   **Cel:** Zarządzanie relacjami między użytkownikami (funkcja online). Operacje nie są synchronizowane przez WatermelonDB.
    *   **Planowane Endpointy (Przykłady):**
        *   `POST /requests/`: Wyślij zaproszenie (wymaga np. email odbiorcy).
        *   `GET /requests/pending/`: Lista otrzymanych, oczekujących zaproszeń.
        *   `GET /requests/sent/`: Lista wysłanych, oczekujących zaproszeń.
        *   `POST /requests/{request_id}/accept/`: Zaakceptuj zaproszenie o danym ID.
        *   `POST /requests/{request_id}/reject/`: Odrzuć zaproszenie (blokuje dalsze zaproszenia między tymi użytkownikami).
        *   `DELETE /requests/sent/{request_id}/`: Anuluj wysłane zaproszenie.
        *   `GET /`: Lista użytkowników, którzy są aktualnie znajomymi.
        *   `DELETE /{user_id}/`: Usuń znajomego o podanym ID użytkownika.


**VI. Przetwarzanie Asynchroniczne (Celery)**

Celery jest używane do obsługi zadań, które mogą zająć więcej czasu, aby nie blokować odpowiedzi API:

*   **Import Przepisów:** `extract_recipes_from_url`, `extract_recipes_from_screenshot`, `extract_recipes_from_pdf`, `extract_recipes_from_text`.
*   **Ninja Import:** `process_ninja_import`.
*   **Przetwarzanie Obrazów (Potencjalnie):** Jeśli zdecydujesz się przenieść logikę z `save()`, zadanie `process_recipe_image` będzie tutaj. Klient będzie informowany przez Polling (sprawdzanie `Recipe.image_url` w odpowiedziach PULL/CRUD) lub przez dedykowaną `Notification` (Rekomendowane).
*   **Wysyłka Emaili:** Choć obecnie jest synchroniczna w widokach `accounts`, można rozważyć przeniesienie `send_mail` do zadań Celery, aby przyspieszyć odpowiedź API, zwłaszcza przy rejestracji i resecie hasła.

**VII. Technologie Kluczowe (Podsumowanie)**

*   Django, DRF, PostgreSQL, Celery, RabbitMQ, WatermelonDB (sync), SimpleJWT, drf-spectacular, python-decouple, django-storages (S3), LiteLLM, Pillow, PyMuPDF, Trafilatura, recipe-scrapers.

**VIII. Środowisko i Deployment (Docker)**

*   Aplikacja jest skonteneryzowana przy użyciu Docker i `docker-compose.yaml`.
*   Zapewnia spójne środowiska dla dewelopmentu i produkcji.
*   Obejmuje serwer Django (Gunicorn), worker Celery, broker RabbitMQ i usługę Browserless (do scrapingu).
*   Konfiguracja zarządzana przez zmienne środowiskowe (`.env`).


Dokumentacja API:
# Dokumentacja API Backendu SmartCook v1

**Base URL:** `/api/v1/`

**Format Danych:** JSON

**Autentykacja:** Większość endpointów wymaga autentykacji za pomocą tokenu JWT Bearer przekazanego w nagłówku `Authorization`.

```http
Authorization: Bearer <access_token>
```

## 🔑 Autentykacja (`/api/auth/`)

Endpointy do zarządzania kontem użytkownika i sesjami API. Bazują głównie na `djangorestframework-simplejwt` i prawdopodobnie `dj-rest-auth` lub widokach niestandardowych.

---

### Rejestracja Użytkownika

*   **Endpoint:** `POST /auth/register/`
*   **Opis:** Tworzy nowe konto użytkownika. Wymaga aktywacji przez email.
*   **Autentykacja:** Nie wymagana.
*   **Request Body:**
    ```json
    {
      "username": "newuser",
      "email": "user@example.com",
      "password": "strongpassword123",
      "password2": "strongpassword123" // Potwierdzenie hasła
    }
    ```
    *   `username` (string, wymagane): Unikalna nazwa użytkownika.
    *   `email` (string, wymagane): Unikalny adres email.
    *   `password` (string, wymagane): Hasło użytkownika.
    *   `password2` (string, wymagane): Potwierdzenie hasła.
*   **Response:**
    *   **`201 Created`**: Sukces. Ciało odpowiedzi może zawierać podstawowe dane użytkownika (bez hasła) lub komunikat o sukcesie i konieczności weryfikacji email.
        ```json
        {
          "username": "newuser",
          "email": "user@example.com"
          // lub {"detail": "User registered successfully. Please check your email for verification."}
        }
        ```
    *   **`400 Bad Request`**: Błędy walidacji (np. hasła się nie zgadzają, email/username zajęty).
        ```json
        {
          "email": ["user with this email already exists."],
          "password": ["Password must contain at least 8 characters."]
        }
        ```

---

### Logowanie Użytkownika

*   **Endpoint:** `POST /auth/login/`
*   **Opis:** Loguje użytkownika i zwraca parę tokenów JWT. Weryfikuje, czy email został potwierdzony.
*   **Autentykacja:** Nie wymagana.
*   **Request Body:**
    ```json
    {
      "login": "user@example.com", // Może być username lub email
      "password": "strongpassword123"
    }
    ```
    *   `login` (string, wymagane): Nazwa użytkownika lub adres email.
    *   `password` (string, wymagane): Hasło użytkownika.
*   **Response:**
    *   **`200 OK`**: Sukces. Zwraca tokeny dostępowy i odświeżający.
        ```json
        {
          "access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        }
        ```
    *   **`400 Bad Request`**: Niepoprawne dane logowania lub email niezweryfikowany.
        ```json
        {
          "detail": "No active account found with the given credentials"
          // lub {"detail": "Email address not verified."}
        }
        ```

---

### Odświeżenie Tokenu Dostępowego

*   **Endpoint:** `POST /auth/refresh-token/`
*   **Opis:** Generuje nowy token dostępowy (`access`) na podstawie ważnego tokenu odświeżającego (`refresh`).
*   **Autentykacja:** Nie wymagana (ale wymaga ważnego `refresh_token`).
*   **Request Body:**
    ```json
    {
      "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." // Ważny token odświeżający
    }
    ```
*   **Response:**
    *   **`200 OK`**: Sukces. Zwraca nowy token dostępowy. Może opcjonalnie zwrócić też nowy token odświeżający (rotacja).
        ```json
        {
          "access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          // "refresh": "..." // opcjonalnie, jeśli rotacja jest włączona
        }
        ```
    *   **`401 Unauthorized` / `400 Bad Request`**: Token odświeżający jest nieprawidłowy, wygasł lub został umieszczony na czarnej liście.
        ```json
        {
          "detail": "Token is invalid or expired",
          "code": "token_not_valid"
        }
        ```

---

### Wylogowanie Użytkownika

*   **Endpoint:** `POST /auth/logout/`
*   **Opis:** Unieważnia sesję użytkownika poprzez dodanie tokenu odświeżającego do czarnej listy.
*   **Autentykacja:** **Wymagana** (ważny `access_token`).
*   **Request Body:**
    ```json
    {
      "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." // Token odświeżający do unieważnienia
    }
    ```
*   **Response:**
    *   **`200 OK` / `204 No Content`**: Sukces. Token odświeżający został dodany do czarnej listy.
    *   **`400 Bad Request`**: Błąd w żądaniu (np. brak tokenu refresh).
    *   **`401 Unauthorized`**: Nieuwierzytelniony dostęp (brak lub nieważny `access_token`).

---

### Weryfikacja Email (API)

*   **Endpoint:** `POST /auth/verify-email/`
*   **Opis:** Weryfikuje email użytkownika na podstawie tokenu UUID. Głównie do testów.
*   **Autentykacja:** Nie wymagana.
*   **Request Body:**
    ```json
    {
      "key": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" // Token UUID z linku weryfikacyjnego
    }
    ```
*   **Response:**
    *   **`200 OK`**: Sukces.
        ```json
        {
          "detail": "Email verified successfully"
        }
        ```
    *   **`400 Bad Request` / `404 Not Found`**: Nieprawidłowy lub wygasły token.
        ```json
        {
          "detail": "Invalid token"
        }
        ```

---

### Weryfikacja Email (Link)

*   **Endpoint:** `GET /auth/verify-email/<uuid:token>/`
*   **Opis:** Weryfikuje email po kliknięciu linku z wiadomości. Renderuje stronę HTML.
*   **Autentykacja:** Nie wymagana.
*   **Parameters (Path):**
    *   `token` (UUID, wymagane): Token weryfikacyjny.
*   **Response:**
    *   **`200 OK`**: Sukces. Zwraca stronę HTML z potwierdzeniem.
    *   **`404 Not Found`**: Nieprawidłowy lub wygasły token. Zwraca stronę HTML z błędem.

---

### Zapomniane Hasło (Rozpoczęcie Resetu)

*   **Endpoint:** `POST /auth/forgot-password/`
*   **Opis:** Wysyła email z linkiem do resetowania hasła na podany adres.
*   **Autentykacja:** Nie wymagana.
*   **Request Body:**
    ```json
    {
      "email": "user@example.com"
    }
    ```
*   **Response:**
    *   **`200 OK`**: Sukces (nawet jeśli email nie istnieje, aby nie ujawniać informacji).
        ```json
        {
          "detail": "Password reset e-mail has been sent."
        }
        ```
    *   **`400 Bad Request`**: Błąd walidacji (np. brak pola email).

---

### Resetowanie Hasła (Wyświetlenie Formularza)

*   **Endpoint:** `GET /auth/reset-password/<uuid:token>/`
*   **Opis:** Wyświetla formularz HTML do ustawienia nowego hasła po kliknięciu linku z emaila.
*   **Autentykacja:** Nie wymagana.
*   **Parameters (Path):**
    *   `token` (UUID, wymagane): Token resetujący hasło.
*   **Response:**
    *   **`200 OK`**: Wyświetla stronę HTML z formularzem.
    *   **`404 Not Found`**: Nieprawidłowy lub wygasły token. Zwraca stronę HTML z błędem.

---

### Resetowanie Hasła (Przetworzenie Formularza)

*   **Endpoint:** `POST /auth/reset-password/<uuid:token>/`
*   **Opis:** Ustawia nowe hasło dla użytkownika na podstawie danych z formularza i tokenu. Renderuje stronę HTML.
*   **Autentykacja:** Nie wymagana.
*   **Parameters (Path):**
    *   `token` (UUID, wymagane): Token resetujący hasło.
*   **Request Body (Form Data):**
    *   `new_password1`: Nowe hasło.
    *   `new_password2`: Potwierdzenie nowego hasła.
*   **Response:**
    *   **`200 OK`**: Sukces. Zwraca stronę HTML z potwierdzeniem zmiany hasła.
    *   **`400 Bad Request` / `404 Not Found`**: Błędy walidacji (hasła się nie zgadzają) lub nieprawidłowy/wygasły token. Zwraca stronę HTML z błędem.

---

### Zmiana Hasła (Zalogowany Użytkownik)

*   **Endpoint:** `POST /auth/change-password/`
*   **Opis:** Pozwala zalogowanemu użytkownikowi zmienić swoje hasło.
*   **Autentykacja:** **Wymagana**.
*   **Request Body:**
    ```json
    {
      "old_password": "currentpassword123",
      "new_password1": "newstrongpassword456",
      "new_password2": "newstrongpassword456"
    }
    ```
*   **Response:**
    *   **`200 OK`**: Sukces.
        ```json
        {
          "detail": "New password has been saved."
        }
        ```
    *   **`400 Bad Request`**: Błędy walidacji (np. stare hasło nieprawidłowe, nowe hasła się nie zgadzają).
    *   **`401 Unauthorized`**: Nieuwierzytelniony dostęp.

---

## 🔄 Synchronizacja WatermelonDB (`/api/sync/`)

Centralny endpoint do synchronizacji danych z klientem WatermelonDB.

---

### Faza Pull (Pobieranie Zmian)

*   **Endpoint:** `GET /sync/`
*   **Opis:** Pobiera zmiany z serwera od ostatniej synchronizacji (`last_pulled_at`). Obsługuje również pierwszą synchronizację i migracje schematu.
*   **Autentykacja:** **Wymagana**.
*   **Query Parameters:**
    *   `last_pulled_at` (string, opcjonalny): Timestamp ostatniego udanego pull'a w milisekundach od epoki UTC. Jeśli `null`, `0` lub nieobecny, traktowane jako pierwsza synchronizacja.
    *   `schema_version` (string, opcjonalny): Wersja schematu bazy danych klienta. Używana do logiki migracji.
    *   `migration` (string, opcjonalny): Informacje o migracji w formacie JSON, wysyłane przez klienta, gdy potrzebuje danych dla nowego schematu (nowe tabele/kolumny). Struktura np.: `{"from": 1, "tables": ["new_table"], "columns": [{"table": "recipes", "columns": ["new_column"]}]}`. Serwer filtruje i przetwarza tylko znane/dozwolone tabele i kolumny.
*   **Response:**
    *   **`200 OK`**: Sukces. Zwraca zmiany i aktualny timestamp serwera.
        ```json
        {
          "changes": {
            "recipes": { // Nazwa tabeli
              "created": [ // Nowe rekordy (lub wszystkie przy pierwszym sync)
                {
                  "id": "uuid-recipe-1",
                  "name": "Pancakes",
                  "description": "Fluffy pancakes",
                  "rating": 5,
                  "is_approved": true,
                  "prep_time": 10,
                  "total_time": 20,
                  "servings": 4,
                  "instructions": "Mix all ingredients...",
                  "notes": "Serve with maple syrup",
                  "nutrition": "Calories: 300",
                  "video": null,
                  "source": null,
                  "image_url": "https://your-s3-bucket.s3.amazonaws.com/media/recipes/uuid-recipe-1.jpg", // URL obrazka, nie plik
                  "last_modified": 1678886400000, // Timestamp w ms
                  "user_id": "uuid-user-1"
                }
              ],
              "updated": [ // Zaktualizowane rekordy od last_pulled_at
                {
                  "id": "uuid-recipe-2",
                  "name": "Updated Omelette",
                  // ... inne pola ...
                  "last_modified": 1678886450000,
                  "user_id": "uuid-user-1"
                }
              ],
              "deleted": [ // ID rekordów usuniętych (soft delete) od last_pulled_at
                "uuid-recipe-3"
              ]
            },
            "ingredients": {
              "created": [
                {
                  "id": "uuid-ingredient-1",
                  "recipe_id": "uuid-recipe-1",
                  "amount": "2",
                  "unit": "cups",
                  "name": "Flour",
                  "type": "Pantry",
                  "order": 1,
                  "original_str": "2 cups Flour",
                  "last_modified": 1678886410000,
                  "user_id": "uuid-user-1"
                }
              ],
              "updated": [],
              "deleted": []
            },
            "user_profile": { // Przykład tabeli read-only dla klienta
              "created": [],
              "updated": [
                 {
                  "id": "uuid-profile-1",
                  "subscription_end": "2024-12-31T23:59:59Z", // ISO 8601 format
                  "csv_lock": null,
                  "last_modified": 1678886300000,
                  "user_id": "uuid-user-1"
                 }
              ],
              "deleted": []
            }
            // ... inne tabele (tags, recipe_tags, shopping_items, notifications, client_user_settings)
          },
          "timestamp": 1678886500000 // Aktualny timestamp serwera w ms
        }
        ```
    *   **`400 Bad Request`**: Nieprawidłowy format parametrów (np. `last_pulled_at`, `migration`).
        ```json
        {
          "error": "Invalid last_pulled_at timestamp format: invalid_timestamp"
          // lub {"error": "Invalid migration JSON format"}
        }
        ```
    *   **`401 Unauthorized`**: Nieuwierzytelniony dostęp.
    *   **`500 Internal Server Error`**: Błąd serwera podczas pobierania zmian.
        ```json
        {
          "error": "Failed to query changes"
        }
        ```

---

### Faza Push (Wysyłanie Zmian)

*   **Endpoint:** `POST /sync/`
*   **Opis:** Wysyła lokalne zmiany klienta na serwer w celu ich zastosowania. Wymaga podania `last_pulled_at` z ostatniego udanego pull'a do wykrywania konfliktów.
*   **Autentykacja:** **Wymagana**.
*   **Query Parameters:**
    *   `last_pulled_at` (string, **wymagane**): Timestamp ostatniego udanego pull'a w milisekundach od epoki UTC. Używany do sprawdzania konfliktów.
*   **Request Body:**
    ```json
    {
      "changes": {
        "recipes": { // Nazwa tabeli
          "created": [ // Nowe rekordy stworzone lokalnie
            {
              "id": "uuid-local-recipe-1", // ID wygenerowane przez klienta
              "name": "New Local Recipe",
              "description": "Created offline",
              // ... inne pola (bez _status, _changed, last_modified)
              "user_id": "uuid-user-1" // Klient musi wiedzieć, do kogo należy rekord
            }
          ],
          "updated": [ // Rekordy zaktualizowane lokalnie
            {
              "id": "uuid-recipe-1", // ID istniejącego rekordu
              "name": "Pancakes updated",
              "rating": 4
              // ... tylko zmienione pola + id
            }
          ],
          "deleted": [ // ID rekordów usuniętych lokalnie
            "uuid-recipe-2"
          ]
        },
        "ingredients": {
          // ... podobna struktura dla innych tabel ...
        },
        "user_profile": { // Zmiany w tej tabeli będą IGNOROWANE przez serwer
            "created": [],
            "updated": [
                {"id": "uuid-profile-1", "some_field": "attempted change"} // Ignored
            ],
            "deleted": []
        }
        // ... inne tabele ...
      }
    }

    ```
    *   **Ważne:** Klient wysyła tylko te rekordy, które zostały zmienione lokalnie (`created`, `updated`, `deleted`) od czasu `last_pulled_at`. Pola `_status` i `_changed` z WatermelonDB **nie są** wysyłane. Pole `last_modified` z klienta jest ignorowane przez serwer. Zmiany dla `user_profile` są ignorowane.
*   **Response:**
    *   **`204 No Content`**: Sukces. Wszystkie zmiany zostały pomyślnie zastosowane na serwerze.
    *   **`400 Bad Request`**: Błąd walidacji danych (np. nieprawidłowy format JSON, brak wymaganego pola w rekordzie, błąd walidacji modelu Django).
        ```json
        {
          "error": "Invalid push data.",
          "details": { // Szczegóły błędów walidacji DRF/Django
             "recipes": {
                "created": [
                    {"rating": ["Ensure this value is less than or equal to 5."]}
                 ]
             }
          }
          // lub {"error": "Missing or invalid 'last_pulled_at' query parameter for push."}
        }
        ```
    *   **`401 Unauthorized`**: Nieuwierzytelniony dostęp.
    *   **`409 Conflict`**: Wykryto konflikt. Przynajmniej jeden z wysłanych rekordów (`updated` lub `deleted`) został zmodyfikowany na serwerze *po* czasie `last_pulled_at` klienta. Klient musi najpierw wykonać `GET /sync/`, rozwiązać konflikty lokalnie i spróbować `POST /sync/` ponownie.
        ```json
        {
          "error": "Conflict detected. Pull changes again.",
          "details": "Conflict updating recipes id=uuid-recipe-1" // Przykładowy komunikat
        }
        ```
    *   **`500 Internal Server Error`**: Niespodziewany błąd serwera podczas przetwarzania zmian.
        ```json
        {
          "error": "Server error during push processing."
        }
        ```

